# —— 服务 ——
DOUBAO_PORT=19071
XRL_ROUTER_URL=http://localhost:19068

# —— 豆包网关 ——
DOUBAO_BASE_URL=https://www.doubao.com
DOUBAO_AUTH_BASE_URL=https://www.doubao.com
# Web 端 aid（与浏览器 / 网页登录一致）
DOUBAO_AID=497858
# 旧版 /samantha 端点使用的桌面 aid
DOUBAO_DESKTOP_AID=582478
DOUBAO_PC_VERSION=3.42.5
DOUBAO_BOT_ID=7338286299411103781
# 对话端点：auto = 先 /chat/completion，失败回退 /samantha/chat/completion
# 可选：chat | samantha
DOUBAO_CHAT_MODE=auto

# —— 自包含网页登录 ——
# 本地登录页端口；被占用时自动改用随机端口
DOUBAO_LOGIN_PORT=19100
DOUBAO_LOGIN_TIMEOUT_MS=300000
DOUBAO_LOGIN_POLL_MS=1500
# 无登录态时服务是否自动发起网页登录（会打开本地登录页）。默认关闭。
DOUBAO_AUTO_LOGIN=0

# —— 自包含凭证存储 ——
# 凭证文件路径（默认落在用户数据目录，不进 git）
# DOUBAO_CREDENTIAL_PATH=
# 存储形态：auto（默认，Windows 用 DPAPI）| dpapi | aes | plain
# DOUBAO_STORE_MODE=auto
# AES 模式 passphrase；设置后 auto 模式优先使用 AES（可跨机迁移）
# 注意：.env 永不提交，切勿写明文密钥到仓库
# DOUBAO_AUTH_SECRET=

# —— 模型注册 ——
# 逗号分隔；留空 = 注册内置模型（doubao-fast / doubao-expert / doubao-work / doubao-work-pro / doubao-2.1-lite）
# DOUBAO_MODELS=doubao-fast,doubao-expert

# —— 请求 ——
DOUBAO_REQUEST_TIMEOUT_MS=600000

# —— 灾备 Cookie（可选：无本地凭证时使用；格式同浏览器 Cookie 头）——
# DOUBAO_COOKIES=sessionid=...; ttwid=...; passport_csrf_token=...
# DOUBAO_UID=

# —— 设备标识（可选：留空则首次登录时生成并随凭证保存）——
# DOUBAO_DEVICE_ID=
# DOUBAO_WEB_ID=
# DOUBAO_FP=

# —— 调试 ——
# DOUBAO_DEBUG=1
